# Copy this file to .env and fill in your values.

# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Answer generation ──────────────────────────────────────────────────────────

# Claude model for answer generation (default: claude-haiku-4-5-20251001)
# Swap to claude-sonnet-4-6 for more thorough answers (higher cost)
# GENERATOR_MODEL=claude-haiku-4-5-20251001

# Maximum tokens in the generated answer (default: 1024)
# GENERATOR_MAX_TOKENS=1024

# Maximum question length in characters — longer questions are rejected (default: 1000)
# MAX_QUESTION_CHARS=1000

# ── Retrieval / chunking ───────────────────────────────────────────────────────

# Approximate word count per chunk (default: 800)
# CHUNK_SIZE=800

# Overlap between consecutive chunks in words (default: 150)
# CHUNK_OVERLAP=150

# How many chunks to retrieve per query (default: 4)
# TOP_K=4

# Where to persist the document store JSON (default: docs_store.json in backend/)
# STORE_PATH=docs_store.json
