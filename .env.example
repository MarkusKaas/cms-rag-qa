# Copy this file to .env and fill in your values.

# Required for answers (uploads and the UI work without it; /health reports "degraded")
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Answer generation ──────────────────────────────────────────────────────────

# Claude model for answer generation. Swap to claude-sonnet-4-6 for more thorough answers (higher cost).
# GENERATOR_MODEL=claude-haiku-4-5-20251001

# Maximum tokens in the generated answer
# GENERATOR_MAX_TOKENS=1024

# Maximum question length in characters — longer questions are rejected with 422
# MAX_QUESTION_CHARS=1000

# ── Retrieval / chunking ───────────────────────────────────────────────────────

# Words per chunk, and words shared between neighbouring chunks.
# CHUNK_OVERLAP must be smaller than CHUNK_SIZE (the app refuses to start otherwise).
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150

# How many chunks to retrieve per query, and the minimum similarity to keep one
# TOP_K=4
# MIN_SCORE=0.0

# Where to persist the document store. Relative paths are resolved against backend/.
# STORE_PATH=docs_store.json

# ── Server ─────────────────────────────────────────────────────────────────────

# Reject uploads larger than this (HTTP 413)
# MAX_UPLOAD_MB=20

# Comma-separated origins allowed to call the API from another origin.
# "*" is fine locally; restrict it when deploying. Not needed for the bundled UI.
# CORS_ORIGINS=*
